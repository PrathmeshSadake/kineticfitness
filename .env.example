# Copy to local.env (gitignored) and fill in real values before starting services.
# export $(grep -v '^#' local.env | xargs) && start each Spring Boot app.

JWT_SECRET=kinetic-fitness-dev-secret-change-me-32chars-min
JWT_EXPIRATION_MS=86400000

DB_URL=jdbc:postgresql://YOUR_HOST/kinetic-fitness
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Activity Mongo database
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/activitiesDB?retryWrites=true&w=majority

# AI recommendations Mongo database (separate DB recommended)
AI_MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/fitnessrecommendationsDB?retryWrites=true&w=majority

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.6-flash

FRONTEND_ORIGIN=http://localhost:5173
